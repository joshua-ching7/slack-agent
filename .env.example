# ── Anthropic ────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Slack ─────────────────────────────────────────────────────
# Bot token from your Slack App (OAuth & Permissions > Bot Token Scopes:
#   chat:write, chat:write.public, reactions:read)
SLACK_BOT_TOKEN=xoxb-...

# Channel names or IDs where each agent posts
SLACK_EVENTS_CHANNEL=#events
SLACK_FINANCE_CHANNEL=#finance-officers

# ── Google (Service Account) ──────────────────────────────────
# Path to your downloaded service account JSON key file.
# Share your Calendar / Sheets with the service account email.
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# ── Event Agent ───────────────────────────────────────────────
# Choose "calendar" to read from Google Calendar,
# or "sheets" to read from a Google Sheet acting as your social calendar.
EVENT_SOURCE=calendar

# Google Calendar ID  (e.g. "primary" or the club calendar ID)
GOOGLE_CALENDAR_ID=primary

# If EVENT_SOURCE=sheets: the spreadsheet ID and sheet range
# Expected columns (0-indexed): Name | Date (YYYY-MM-DD) | Time | Location | Description | Type
GOOGLE_SOCIAL_SHEET_ID=
GOOGLE_SOCIAL_SHEET_RANGE=Sheet1!A2:F

# How many days before an event to send a reminder (comma-separated)
REMINDER_DAYS_BEFORE=7,3,1,0

# How often to check for upcoming events (minutes)
EVENT_CHECK_INTERVAL_MINUTES=60

# ── Finance Agent ─────────────────────────────────────────────
# The Google Sheet that collects your reimbursement form responses.
# Share this sheet with the service account email (Editor recommended
# if you want the agent to update a status column; Viewer otherwise).
GOOGLE_REIMBURSEMENT_SHEET_ID=your_sheet_id_here
GOOGLE_REIMBURSEMENT_SHEET_RANGE=Form Responses 1!A:I

# 0-based column indices matching your form's column order
REIMBURSEMENT_COL_TIMESTAMP=0
REIMBURSEMENT_COL_NAME=1
REIMBURSEMENT_COL_EMAIL=2
REIMBURSEMENT_COL_AMOUNT=3
REIMBURSEMENT_COL_CATEGORY=4
REIMBURSEMENT_COL_EVENT=5
REIMBURSEMENT_COL_DESCRIPTION=6
REIMBURSEMENT_COL_RECEIPT=7

# How often to poll for new reimbursement submissions (minutes)
FINANCE_CHECK_INTERVAL_MINUTES=15

# ── General ───────────────────────────────────────────────────
CLUB_NAME=My Club
# File used to persist reminder/reimbursement state between restarts
STATE_FILE=state.json
